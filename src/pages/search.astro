---
import './styles/search.scss';
import InputSearch from '../shared/components/InputSearch.astro';
import SecondaryLayout from '../core/layouts/SecondaryLayout.astro';
import HeaderSecondary from '../core/layouts/HeaderSecondary.astro';
import CardList from '../features/cards/components/CardList.astro';
---
<SecondaryLayout title="Поиск">
  <div class="wrapper" id="container">
    <HeaderSecondary>
      <div class="search-input">
        <InputSearch placeholder="Поиск хадисов" />
        <div class="search-result-quantity">
          <span id="result-quantity">
            100
          </span>
          хадисов найдено
        </div>
      </div>
    </HeaderSecondary>
  </div>
</SecondaryLayout>
<script>
  const container = document.getElementById('container');
  const params = new URLSearchParams(window.location.search);
  const query = decodeURIComponent(params.get('query') || '');
  const cardList = document.createElement('div');
  cardList.innerHTML = `<CardList searchText='${ query }' />`;
  if (container) {
    container.appendChild(cardList);
  }
</script>